TV_SECRET=replace-with-a-long-random-secret
TG_TOKEN=telegram-bot-token
TG_CHAT_ID=telegram-chat-id

# Zeabur Redis template usually injects REDIS_CONNECTION_STRING automatically.
# REDIS_URL is only needed for local fallback or manual Redis setup.
REDIS_URL=redis://localhost:6379/0

BATCH_SECONDS=2
BATCH_MAX=200
TELEGRAM_MIN_INTERVAL=1.1
DEDUP_TTL_SECONDS=300
QUEUE_KEY=tv:signals
DEDUP_PREFIX=tv:dedup:
